APP_ENV=local
APP_NAME=crm-backend
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL — do NOT commit real credentials
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# JWT / password hashing — do NOT commit a real secret
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
PASSWORD_BCRYPT_ROUNDS=12

# Optional: created on startup if both are set (idempotent)
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=
